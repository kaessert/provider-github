package {{ .Env.KIND | strings.ToLower }}

import (
	"context"

	"github.com/crossplane/crossplane-runtime/v2/pkg/errors"
	"github.com/crossplane/crossplane-runtime/v2/pkg/reconciler/managed"
	"github.com/crossplane/crossplane-runtime/v2/pkg/resource"

	"{{ .Env.PROJECT_REPO }}/apis/cluster/{{ .Env.GROUP | strings.ToLower }}/{{ .Env.APIVERSION | strings.ToLower }}"
	ghclient "{{ .Env.PROJECT_REPO }}/internal/clients"
)

const (
	errNot{{ .Env.KIND }} = "managed resource is not a {{ .Env.KIND }} custom resource"
	errTrackPCUsage = "cannot track ProviderConfig usage"
	errGetPC        = "cannot get ProviderConfig"
	errNewClient    = "cannot create new Service"
)

// external implements managed.ExternalClient for {{ .Env.KIND }}. One implementation
// serves both API scopes: the namespaced controller wraps it so it sees the
// cluster-scoped form of the resource.
type external struct {
	github *ghclient.Client
}

func (c *external) Observe(_ context.Context, mg resource.Managed) (managed.ExternalObservation, error) {
	if _, ok := mg.(*{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}); !ok {
		return managed.ExternalObservation{}, errors.New(errNot{{ .Env.KIND }})
	}

	// TODO: read the resource from GitHub and report whether it exists and
	// whether it matches spec.forProvider.
	return managed.ExternalObservation{
		ResourceExists:   true,
		ResourceUpToDate: true,
	}, nil
}

func (c *external) Create(_ context.Context, mg resource.Managed) (managed.ExternalCreation, error) {
	if _, ok := mg.(*{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}); !ok {
		return managed.ExternalCreation{}, errors.New(errNot{{ .Env.KIND }})
	}

	// TODO: create the resource on GitHub.
	return managed.ExternalCreation{}, nil
}

func (c *external) Update(_ context.Context, mg resource.Managed) (managed.ExternalUpdate, error) {
	if _, ok := mg.(*{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}); !ok {
		return managed.ExternalUpdate{}, errors.New(errNot{{ .Env.KIND }})
	}

	// TODO: update the resource on GitHub.
	return managed.ExternalUpdate{}, nil
}

func (c *external) Delete(_ context.Context, mg resource.Managed) (managed.ExternalDelete, error) {
	if _, ok := mg.(*{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}); !ok {
		return managed.ExternalDelete{}, errors.New(errNot{{ .Env.KIND }})
	}

	// TODO: delete the resource on GitHub.
	return managed.ExternalDelete{}, nil
}

// Disconnect is a no-op: the GitHub client is cached and shared across
// reconciles, so there is nothing to release per connection.
func (c *external) Disconnect(_ context.Context) error {
	return nil
}

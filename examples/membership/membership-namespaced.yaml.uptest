for: organizations.github.m.crossplane.io/v1alpha1/Membership
meta.upbound.io/example-id: organizations/v1alpha1/membership
uptest.upbound.io/timeout: "600"
uptest.upbound.io/post-assert-hook: ../../test/hooks/post-assert-membership-namespaced.sh
crossplane.io/update-test: |
  - field: role
    skip:
      reason: fixture-missing
      evidence: "admin is the only other role an existing membership can be edited to, and the provider refuses to delete a membership whose role is admin, so patching it would leave an undeletable resource; the invitee this example needs is also an out-of-band prerequisite"
  - field: org
    skip: "organization locator: a different value addresses another organization's object, it is not an update"

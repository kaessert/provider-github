for: organizations.github.m.crossplane.io/v1alpha1/DependabotSecretAccess
meta.upbound.io/example-id: organizations/v1alpha1/dependabotsecretaccess
uptest.upbound.io/timeout: "600"
uptest.upbound.io/post-assert-hook: ../../test/hooks/post-assert-dependabot-secret-access-namespaced.sh
crossplane.io/update-test: |
  - field: org
    skip: "organization locator: a different value addresses another organization's object, it is not an update"
  - field: visibility
    skip:
      reason: write-only
  - field: selectedRepositories
    skip:
      reason: write-only

for: organizations.github.m.crossplane.io/v1alpha1/ActionsSecretAccess
meta.upbound.io/example-id: organizations/v1alpha1/actionssecretaccess
uptest.upbound.io/timeout: "600"
uptest.upbound.io/post-assert-hook: ../../test/hooks/post-assert-actions-secret-access-namespaced.sh
crossplane.io/update-test: |
  - field: visibility
    skip:
      reason: vendor-defect
      evidence: "GitHub's API changes an organization secret's visibility only together with the secret value, which the provider never holds; a visibility that differs from GitHub's is reported as a VisibilityMismatch condition and nothing is written"
  - field: selectedRepositories
    value:
      - repo: demo-repository-2
  - field: selectedRepositories
    value: []
  - field: org
    skip: "organization locator: a different value addresses another organization's object, it is not an update"

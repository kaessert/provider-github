for: organizations.github.m.crossplane.io/v1alpha1/OrganizationWebhook
meta.upbound.io/example-id: organizations/v1alpha1/organizationwebhook
uptest.upbound.io/timeout: "600"
uptest.upbound.io/post-assert-hook: ../../test/hooks/post-assert-organization-webhook-namespaced.sh
crossplane.io/update-test: |
  - field: url
    value: https://example.com/pgh-e2e-ns-updated
  - field: contentType
    value: form
  - field: events
    value:
      - repository
      - team
  - field: active
    value: false
  - field: insecureSsl
    value: true
  - field: secretKeyRef
    skip:
      reason: write-only
  - field: org
    skip: "organization locator: a different value addresses another organization's object, it is not an update"

for: organizations.github.m.crossplane.io/v1alpha1/Organization
meta.upbound.io/example-id: organizations/v1alpha1/organization
uptest.upbound.io/timeout: "600"
uptest.upbound.io/post-assert-hook: ../../test/hooks/post-assert-organization-namespaced.sh
crossplane.io/update-test: |
  - field: description
    value: Crossplane provider-github updated organization description
  - field: actions
    value:
      enabledRepos:
        - repo: demo-repository-1
        - repo: demo-repository-2
        - repo: pgh-e2e-workflows
  - field: actions
    value:
      enabledRepos:
        - repo: demo-repository-1
        - repo: demo-repository-2
  - field: secrets
    value:
      actionsSecrets:
        - name: PGH_E2E_ORG_ACTIONS_SECRET_NS
          repositoryAccessList:
            - repo: demo-repository-2
      dependabotSecrets:
        - name: PGH_E2E_ORG_DEPENDABOT_SECRET_NS
          repositoryAccessList:
            - repo: demo-repository-2
  - field: secrets
    value:
      actionsSecrets:
        - name: PGH_E2E_ORG_ACTIONS_SECRET_NS
          repositoryAccessList: []
      dependabotSecrets:
        - name: PGH_E2E_ORG_DEPENDABOT_SECRET_NS
          repositoryAccessList: []
  - field: description
    value: Crossplane provider-github organization description once the lists are dropped
    clear:
      - actions
      - secrets

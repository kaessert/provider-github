for: organizations.github.crossplane.io/v1alpha1/ActionsOrganizationSecret
meta.upbound.io/example-id: organizations/v1alpha1/actionsorganizationsecret
uptest.upbound.io/timeout: "600"
uptest.upbound.io/post-assert-hook: ../../test/hooks/post-assert-actions-organization-secret.sh
crossplane.io/update-test: |
  # The list is only observable while visibility is selected, so it is tested
  # first; the visibility change that follows clears it.
  - field: selectedRepositories
    value:
      - repo: demo-repository-2
  - field: visibility
    value: private
    clear:
      - selectedRepositories
  - field: valueSecretRef
    skip:
      reason: write-only
  - field: org
    skip: "organization locator: a different value addresses another organization's object, it is not an update"
